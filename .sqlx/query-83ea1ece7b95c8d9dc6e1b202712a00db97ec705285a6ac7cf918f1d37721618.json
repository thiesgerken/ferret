{
  "db_name": "PostgreSQL",
  "query": "select c.id, c.source, c.archive_store_id from plugin_runs r\n         join connections c on c.id = r.connection_id\n         join users u on u.id = c.user_id\n         where r.id = $1 and r.status = 'running' and c.user_id = $2\n           and c.plugin = 'whatsapp' and u.enabled\n           and r.heartbeat_at >= now() - make_interval(secs => $3)\n         for update of r, c",
