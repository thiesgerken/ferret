{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)nix/pg-search-binaries\\.json$/"],
      "matchStrings": ["\"version\":\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "paradedb/paradedb",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Group patch, pin, and digest updates into a single PR",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "all routine dependency updates",
      "groupSlug": "all-routine-dependencies"
    },
    {
      "description": "Disable digest pinning for the Helm chart values file",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "charts/carapace/values.yaml"
      ],
      "pinDigests": false
    },
    {
      "description": "pnpm and frontend lock updates require the documented Nix dependency-cache refresh before merge",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "automerge": false
    },
    {
      "description": "pg_search release updates require the documented official binary hash refresh and full database checks",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["paradedb/paradedb"],
      "automerge": false
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "commitMessagePrefix": "⬆️ chore: ",
  "commitMessageAction": "upgrade",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}"
}
